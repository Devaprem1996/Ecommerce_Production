# =================================================================
# SELF-HOSTED ENVIRONMENT CONFIGURATION (LOCAL SIMULATION & VPS)
# =================================================================

# 1. Server Environment
NODE_ENV=production
DOMAIN_NAME=yathuarokiyagam.com
SERVER_IP=127.0.0.1
SERVER_NAME=Yathu-Production-VPS

# 2. Self-Hosted PostgreSQL Database (Tuned for 8GB RAM VPS)
POSTGRES_DB=yathu_ecommerce
POSTGRES_USER=yathu_admin
POSTGRES_PASSWORD=your_strong_postgres_password_here
POSTGRES_PORT=5432
DATABASE_URL=postgresql://yathu_admin:your_strong_postgres_password_here@postgres:5432/yathu_ecommerce?sslmode=disable&connection_limit=20&pool_timeout=10
DIRECT_URL=postgresql://yathu_admin:your_strong_postgres_password_here@postgres:5432/yathu_ecommerce?sslmode=disable&connection_limit=20&pool_timeout=10

# 3. Security & Authentication Keys
JWT_SECRET=generate_a_secure_64_character_hex_string_here_1234567890
REFRESH_TOKEN_SECRET=generate_another_secure_64_character_hex_string_here_0987654321

# 4. Frontend & Backend URLs
PORT=8080
FRONTEND_URL=https://yathuarokiyagam.com
NEXT_PUBLIC_API_URL=/api/v1

# 5. Third-Party Gateway Integrations
# SMS Gateway (Fast2SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Transactional Email (Gmail SMTP / Domain Webmail)
GMAIL_USER=your_business_email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# 6. Media / Image Storage Driver
STORAGE_DRIVER=local
LOCAL_UPLOAD_PATH=/var/www/uploads
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# 7. Real-Time Observability & Instant Error Tracking (Sentry)
SENTRY_DSN=https://your_sentry_dsn_key@o0.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.2

# 8. Real-Time Mobile Alerting (Telegram Bot)
# Create bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789

# 9. VPS Host Resource Monitoring Thresholds
RAM_THRESHOLD=85
DISK_THRESHOLD=85

# 10. Monitoring (Uptime Kuma)
UPTIME_KUMA_PORT=3001
