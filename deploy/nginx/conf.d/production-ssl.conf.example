# =================================================================
# NGINX PRODUCTION VPS CONFIGURATION (HTTPS + LET'S ENCRYPT SSL)
# =================================================================
# Usage:
# 1. Replace 'yathuarokiyagam.com' with your production domain name.
# 2. Rename this file to 'production-ssl.conf' when deploying on Hostinger VPS.
# =================================================================

upstream frontend_app {
    server frontend:3000;
    keepalive 32;
}

upstream backend_api {
    server backend:8080;
    keepalive 32;
}

# Redirect all HTTP requests to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name yathuarokiyagam.com www.yathuarokiyagam.com;

    # Certbot challenge path
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# Main HTTPS Server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name yathuarokiyagam.com www.yathuarokiyagam.com;

    # SSL Certificates (Auto-managed by Certbot)
    ssl_certificate /etc/letsencrypt/live/yathuarokiyagam.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/yathuarokiyagam.com/privkey.pem;

    # Modern SSL Security Parameters
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # 1. Local Media / Product Uploads (Direct disk serving)
    location /uploads/ {
        alias /var/www/uploads/;
        autoindex off;
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
        try_files $uri =404;
    }

    # 2. Backend Express REST API
    location /api/v1/ {
        proxy_pass http://backend_api;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
        proxy_buffering off;
    }

    # 3. Next.js Frontend Web Application
    location / {
        proxy_pass http://frontend_app;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        location /_next/static/ {
            proxy_pass http://frontend_app;
            proxy_set_header Host $host;
            expires 365d;
            add_header Cache-Control "public, max-age=31536000, immutable";
            access_log off;
        }
    }
}
