# ==============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), set these in Project Settings -> Environment Variables.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Backend API Endpoint (Used by client-side hooks and server fetchers)
NEXT_PUBLIC_API_URL="http://localhost:8080/api/v1"

# Internal Backend URL (Used for server-side Next.js route proxies)
BACKEND_URL="http://localhost:8080"

# JWT Secret for cookie verification and route guards (Must match backend JWT_SECRET)
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"

# Database Connection (Neon/Local PostgreSQL - if using server actions or Prisma)
DATABASE_URL="postgresql://username:password@hostname:port/database_name?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname:port/database_name?sslmode=require"

# Cloud Storage Configuration (Cloudinary Assets)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# Optional Maintenance Mode Flags
# MAINTENANCE_MODE="false"
# NEXT_PUBLIC_MAINTENANCE_MODE="false"
# NEXT_PUBLIC_MAINTENANCE_END_TIME=""
